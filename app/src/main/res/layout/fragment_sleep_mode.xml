<?xml version="1.0" encoding="utf-8"?>
<!-- Sleep mode. One 24-hour dial with two handles replaces the two TimePicker
     spinners and the seven checkboxes: the night is a shape you can see, and
     the hours of quiet are the number in the middle. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/skor_ground">

    <include
        android:id="@+id/back_header"
        layout="@layout/view_back_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="@dimen/spacing_md">

        <FrameLayout
            android:layout_width="252dp"
            android:layout_height="252dp"
            android:layout_marginTop="@dimen/spacing_sm">

            <com.example.stayfree.ui.common.ArcPickerView
                android:id="@+id/arc_night"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_start_time"
                    style="@style/Skor.Metric"
                    android:textSize="28sp"
                    tools:text="23:00" />

                <TextView
                    android:id="@+id/tv_quiet_length"
                    style="@style/Skor.Micro"
                    android:layout_marginVertical="7dp"
                    tools:text="8h 0m tišine" />

                <TextView
                    android:id="@+id/tv_end_time"
                    style="@style/Skor.Metric"
                    android:textSize="28sp"
                    tools:text="07:00" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            style="@style/Skor.Micro"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center"
            android:text="@string/sleep_drag_hint" />

        <TextView
            style="@style/Skor.Label"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:text="@string/sleep_days" />

        <!-- Chips, not checkboxes: same Checkable contract, far less chrome. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <com.google.android.material.chip.Chip
                android:id="@+id/cb_mon"
                style="@style/Skor.DayChip"
                android:text="@string/day_m" />

            <com.google.android.material.chip.Chip
                android:id="@+id/cb_tue"
                style="@style/Skor.DayChip"
                android:text="@string/day_t" />

            <com.google.android.material.chip.Chip
                android:id="@+id/cb_wed"
                style="@style/Skor.DayChip"
                android:text="@string/day_w" />

            <com.google.android.material.chip.Chip
                android:id="@+id/cb_thu"
                style="@style/Skor.DayChip"
                android:text="@string/day_th" />

            <com.google.android.material.chip.Chip
                android:id="@+id/cb_fri"
                style="@style/Skor.DayChip"
                android:text="@string/day_f" />

            <com.google.android.material.chip.Chip
                android:id="@+id/cb_sat"
                style="@style/Skor.DayChip"
                android:checked="true"
                android:text="@string/day_s" />

            <com.google.android.material.chip.Chip
                android:id="@+id/cb_sun"
                style="@style/Skor.DayChip"
                android:checked="true"
                android:text="@string/day_su" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            style="@style/Skor.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/skor_night"
            android:textColor="@color/skor_on_night"
            android:text="@string/btn_save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            style="@style/Skor.Button.Neutral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/btn_cancel" />
    </LinearLayout>
</LinearLayout>
