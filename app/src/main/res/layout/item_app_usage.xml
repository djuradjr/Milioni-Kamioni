<?xml version="1.0" encoding="utf-8"?>
<!-- Skor list row: flat fill, no elevation. The bar is orange only when the app
     is categorised as a distraction — that colour is a claim, not decoration. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="6dp"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp"
    android:background="@drawable/bg_skor_card"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/iv_app_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_app_name"
            style="@style/Skor.Body"
            android:layout_width="match_parent"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_unlock_count"
            style="@style/Skor.Micro"
            android:layout_marginTop="1dp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_usage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            app:trackThickness="4dp"
            app:trackCornerRadius="2dp"
            app:trackStopIndicatorSize="0dp"
            app:indicatorColor="@color/skor_idle"
            app:trackColor="@color/skor_track"
            android:max="100" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_usage_time"
        style="@style/Skor.Body"
        android:layout_marginStart="12dp"
        android:textColor="@color/skor_text_dim"
        android:fontFeatureSettings="tnum" />

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="6dp"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/skor_text_dim"
        android:importantForAccessibility="no" />
</LinearLayout>
