<?xml version="1.0" encoding="utf-8"?>
<!-- Hard-block screen over the host app: branded, immersive, no timer, no
     unlock path — the single action is Exit → home. Orange appears only on the
     block mark itself; the rest sits on the Skor ground. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/block_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="32dp">

        <FrameLayout
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginBottom="26dp"
            android:background="@drawable/bg_skor_dot"
            android:backgroundTint="@color/skor_distraction_soft">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_block"
                app:tint="@color/skor_distraction"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_title"
            style="@style/Skor.Text"
            android:gravity="center"
            android:textSize="24sp"
            android:textFontWeight="700"
            android:textStyle="bold"
            android:letterSpacing="-0.025"
            tools:text="Reels blocked" />

        <TextView
            android:id="@+id/tv_message"
            style="@style/Skor.Text"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/content_block_message"
            android:textColor="@color/skor_text_dim"
            android:textSize="15sp" />

        <!-- The count that proves the app is doing its job. Same number as the
             dashboard tile and the protection hub. -->
        <LinearLayout
            android:id="@+id/card_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="26dp"
            android:padding="16dp"
            android:background="@drawable/bg_skor_card"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_block_count"
                style="@style/Skor.Metric"
                android:textSize="26sp"
                android:textColor="@color/skor_focus"
                tools:text="23." />

            <TextView
                android:id="@+id/tv_block_count_caption"
                style="@style/Skor.Caption"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:lineSpacingMultiplier="1.25"
                tools:text="put danas da te Block Brainrot zaustavio" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_exit"
            style="@style/Skor.Button.Neutral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/content_block_exit" />
    </LinearLayout>

</FrameLayout>
