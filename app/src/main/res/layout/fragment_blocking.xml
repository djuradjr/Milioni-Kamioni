<?xml version="1.0" encoding="utf-8"?>
<!-- Skor "Zaštita" hub. Tools are a list, not a 2×2 grid of identical cards:
     order is the order people reach for them — apps and content first, sleep
     last. The result (blocks fired today) leads, so the screen opens with what
     the app did for you rather than with configuration. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/skor_ground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_md">

                <TextView
                    style="@style/Skor.Title"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/blocking_tools_title" />

                <TextView
                    android:id="@+id/tv_active_tools"
                    style="@style/Skor.Micro"
                    tools:text="2 aktivna" />
            </LinearLayout>

            <!-- Only without premium: blocking is the paid feature, and the blocks the
                 user set up stay stored until it is back. -->
            <LinearLayout
                android:id="@+id/card_premium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:background="@drawable/bg_skor_card"
                android:backgroundTint="@color/skor_focus_soft"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/Skor.Body"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical"
                    android:text="@string/blocking_premium_title"
                    android:textFontWeight="700"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_lock"
                    app:drawableTint="@color/skor_focus" />

                <TextView
                    style="@style/Skor.Caption"
                    android:layout_width="match_parent"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.25"
                    android:text="@string/blocking_premium_desc" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_premium"
                    style="@style/Skor.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/blocking_premium_cta" />
            </LinearLayout>

            <!-- Premium without the blocking permissions (bought after skipping them in
                 onboarding, or a permission revoked): nothing would be blocked. -->
            <LinearLayout
                android:id="@+id/card_setup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:background="@drawable/bg_skor_card"
                android:backgroundTint="@color/skor_warn_soft"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/Skor.Body"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical"
                    android:text="@string/blocking_setup_title"
                    android:textFontWeight="700"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_shield"
                    app:drawableTint="@color/skor_warn" />

                <TextView
                    style="@style/Skor.Caption"
                    android:layout_width="match_parent"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.25"
                    android:text="@string/blocking_setup_desc" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_setup"
                    style="@style/Skor.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/blocking_setup_cta" />
            </LinearLayout>

            <!-- What the protection actually did today — same number as the
                 dashboard tile and the block screen, so the loop closes. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/spacing_md"
                android:background="@drawable/bg_skor_card"
                android:layout_marginBottom="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_blocks_today"
                        style="@style/Skor.Metric"
                        android:textColor="@color/skor_focus"
                        tools:text="23" />

                    <TextView
                        android:id="@+id/tv_blocks_caption"
                        style="@style/Skor.Caption"
                        android:layout_marginTop="4dp"
                        android:text="@string/blocking_blocks_today" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Skor.Label"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/blocking_tools_section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_skor_card"
                android:layout_marginBottom="@dimen/spacing_md">

                <!-- 1 · Apps and content -->
                <LinearLayout
                    android:id="@+id/btn_in_app_blocking"
                    style="@style/Skor.ToolRow">

                    <ImageView
                        style="@style/Skor.ToolIcon"
                        android:src="@drawable/ic_tool_shield"
                        app:tint="@color/skor_distraction"
                        android:backgroundTint="@color/skor_distraction_soft" />

                    <LinearLayout style="@style/Skor.ToolText">

                        <TextView style="@style/Skor.Body" android:text="@string/blocking_block_apps" />

                        <TextView
                            style="@style/Skor.Micro"
                            android:layout_marginTop="1dp"
                            android:text="@string/blocking_block_apps_desc" />
                    </LinearLayout>

                    <TextView android:id="@+id/status_block_apps" style="@style/Skor.ToolStatusNew" />
                </LinearLayout>

                <View style="@style/Skor.Divider" />

                <!-- 2 · Websites -->
                <LinearLayout
                    android:id="@+id/btn_website_blocking"
                    style="@style/Skor.ToolRow">

                    <ImageView
                        style="@style/Skor.ToolIcon"
                        android:src="@drawable/ic_tool_globe"
                        app:tint="@color/skor_text_dim"
                        android:backgroundTint="@color/skor_card_raised" />

                    <LinearLayout style="@style/Skor.ToolText">

                        <TextView style="@style/Skor.Body" android:text="@string/blocking_websites" />

                        <TextView
                            style="@style/Skor.Micro"
                            android:layout_marginTop="1dp"
                            android:text="@string/blocking_websites_desc" />
                    </LinearLayout>

                    <TextView android:id="@+id/status_websites" style="@style/Skor.ToolStatusNew" />
                </LinearLayout>

                <View style="@style/Skor.Divider" />

                <!-- 3 · Focus -->
                <LinearLayout
                    android:id="@+id/btn_focus_mode"
                    style="@style/Skor.ToolRow">

                    <ImageView
                        style="@style/Skor.ToolIcon"
                        android:src="@drawable/ic_tool_focus"
                        app:tint="@color/skor_focus"
                        android:backgroundTint="@color/skor_focus_soft" />

                    <LinearLayout style="@style/Skor.ToolText">

                        <TextView style="@style/Skor.Body" android:text="@string/blocking_focus_mode" />

                        <TextView
                            style="@style/Skor.Micro"
                            android:layout_marginTop="1dp"
                            android:text="@string/blocking_focus_desc" />
                    </LinearLayout>

                    <TextView android:id="@+id/status_focus" style="@style/Skor.ToolStatusNew" />
                </LinearLayout>

                <View style="@style/Skor.Divider" />

                <!-- 4 · Sleep -->
                <LinearLayout
                    android:id="@+id/btn_sleep_mode"
                    style="@style/Skor.ToolRow">

                    <ImageView
                        style="@style/Skor.ToolIcon"
                        android:src="@drawable/ic_tool_moon"
                        app:tint="@color/skor_night"
                        android:backgroundTint="@color/skor_night_soft" />

                    <LinearLayout style="@style/Skor.ToolText">

                        <TextView style="@style/Skor.Body" android:text="@string/blocking_sleep_mode" />

                        <TextView
                            style="@style/Skor.Micro"
                            android:layout_marginTop="1dp"
                            android:text="@string/blocking_sleep_desc" />
                    </LinearLayout>

                    <TextView android:id="@+id/status_sleep" style="@style/Skor.ToolStatusNew" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_sm">

                <TextView
                    style="@style/Skor.Label"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/blocking_app_rules" />

                <TextView
                    android:id="@+id/tv_rules_count"
                    style="@style/Skor.Micro"
                    tools:text="3 aktivna" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_block_rules"
                android:layoutAnimation="@anim/layout_animation_slide_up"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <LinearLayout
                android:id="@+id/empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="@dimen/spacing_lg"
                android:background="@drawable/bg_skor_card"
                android:visibility="gone">

                <TextView
                    style="@style/Skor.Body"
                    android:text="@string/blocking_rules_empty" />

                <TextView
                    style="@style/Skor.Micro"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/blocking_rules_empty_desc" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
