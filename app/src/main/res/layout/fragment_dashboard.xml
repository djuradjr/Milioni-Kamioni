<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/skor_ground">

    <!-- Segmented period switch: navy pill track, amber active segment -->
    <LinearLayout
        android:id="@+id/seg_periods"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="@dimen/spacing_md"
        android:layout_marginTop="@dimen/spacing_sm"
        android:padding="3dp"
        android:background="@drawable/bg_skor_seg_track">

        <TextView
            android:id="@+id/seg_day"
            style="@style/Widget.App.DashSegment"
            android:text="@string/stats_daily" />

        <TextView
            android:id="@+id/seg_week"
            style="@style/Widget.App.DashSegment"
            android:text="@string/stats_weekly" />

        <TextView
            android:id="@+id/seg_month"
            style="@style/Widget.App.DashSegment"
            android:text="@string/stats_monthly" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/dashboard_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <LinearLayout
                android:id="@+id/daily_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Date stepper. The date IS the label here — a separate
                     "screen time" caption would only repeat the one below. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/btn_prev_day"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_chevron_left"
                        app:tint="@color/skor_text_dim"
                        android:contentDescription="@string/dashboard_prev_day" />

                    <TextView
                        android:id="@+id/tv_hero_label"
                        style="@style/Skor.Label"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="center" />

                    <ImageButton
                        android:id="@+id/btn_next_day"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/skor_text_dim"
                        android:contentDescription="@string/dashboard_next_day" />
                </LinearLayout>

                <!-- Hero: the ring carries the screen, the total sits beside it -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:layout_marginBottom="@dimen/spacing_md">

                    <FrameLayout
                        android:layout_width="116dp"
                        android:layout_height="116dp">

                        <com.example.stayfree.ui.common.ScoreRingView
                            android:id="@+id/score_ring"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tv_score"
                                style="@style/Skor.Display"
                                tools:text="38" />

                            <TextView
                                style="@style/Skor.Label"
                                android:layout_marginTop="3dp"
                                android:textSize="10sp"
                                android:text="@string/dashboard_score_label" />
                        </LinearLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/spacing_md">

                        <TextView
                            style="@style/Skor.Label"
                            android:text="@string/dashboard_screen_today" />

                        <TextView
                            android:id="@+id/tv_total_screen_time"
                            style="@style/Skor.Metric"
                            android:layout_marginTop="5dp"
                            tools:text="4h 12m" />

                        <TextView
                            android:id="@+id/tv_goal_chip"
                            style="@style/Skor.Chip"
                            android:layout_marginTop="9dp"
                            android:backgroundTint="@color/skor_distraction_soft"
                            android:textColor="@color/skor_distraction"
                            tools:text="12m preko cilja" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Hour by hour: colour is what makes this readable, not shape -->
                <androidx.cardview.widget.CardView
                    style="@style/Skor.Card"
                    android:layout_marginBottom="@dimen/spacing_sm">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/Skor.CardTitle"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:text="@string/dashboard_hourly_title" />

                            <TextView
                                android:id="@+id/tv_peak_time"
                                style="@style/Skor.Micro"
                                tools:text="vrh 22h" />
                        </LinearLayout>

                        <com.example.stayfree.ui.common.HourlyBarsView
                            android:id="@+id/chart_hourly"
                            android:layout_width="match_parent"
                            android:layout_height="74dp"
                            android:layout_marginTop="@dimen/spacing_sm" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="6dp">

                            <TextView style="@style/Skor.Micro" android:textSize="9sp" android:text="00" />
                            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                            <TextView style="@style/Skor.Micro" android:textSize="9sp" android:text="06" />
                            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                            <TextView style="@style/Skor.Micro" android:textSize="9sp" android:text="12" />
                            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                            <TextView style="@style/Skor.Micro" android:textSize="9sp" android:text="18" />
                            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                            <TextView style="@style/Skor.Micro" android:textSize="9sp" android:text="23" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="@dimen/spacing_sm">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_skor_dot"
                                android:backgroundTint="@color/skor_distraction" />

                            <TextView
                                android:id="@+id/tv_legend_distraction"
                                style="@style/Skor.Micro"
                                android:textSize="9sp"
                                android:layout_marginStart="5dp"
                                android:layout_marginEnd="@dimen/spacing_sm"
                                tools:text="Distrakcija 3h 31m" />

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_skor_dot"
                                android:backgroundTint="@color/skor_idle" />

                            <TextView
                                android:id="@+id/tv_legend_other"
                                style="@style/Skor.Micro"
                                android:textSize="9sp"
                                android:layout_marginStart="5dp"
                                tools:text="Ostalo 41m" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Three tiles: the raw counts the score is built from -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:layout_marginBottom="@dimen/spacing_md">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_skor_card">

                        <TextView
                            android:id="@+id/tv_unlocks"
                            style="@style/Skor.MetricSmall"
                            tools:text="87" />

                        <TextView
                            style="@style/Skor.Micro"
                            android:textSize="9sp"
                            android:layout_marginTop="5dp"
                            android:text="@string/dashboard_unlocks" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md"
                        android:layout_marginHorizontal="4dp"
                        android:background="@drawable/bg_skor_card">

                        <TextView
                            android:id="@+id/tv_intercepted"
                            style="@style/Skor.MetricSmall"
                            android:textColor="@color/skor_focus"
                            tools:text="23" />

                        <TextView
                            style="@style/Skor.Micro"
                            android:textSize="9sp"
                            android:layout_marginTop="5dp"
                            android:text="@string/dashboard_intercepted" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_skor_card">

                        <TextView
                            android:id="@+id/tv_streak"
                            style="@style/Skor.MetricSmall"
                            tools:text="6" />

                        <TextView
                            style="@style/Skor.Micro"
                            android:textSize="9sp"
                            android:layout_marginTop="5dp"
                            android:text="@string/dashboard_streak_record" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/Skor.Label"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:text="@string/dashboard_most_used_apps" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_top_apps"
                    android:layoutAnimation="@anim/layout_animation_slide_up"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

            <!-- Weekly/Monthly rolling-window content -->
            <LinearLayout
                android:id="@+id/period_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Hero: period average + unlocks + trend badge -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    app:cardBackgroundColor="@color/skor_card"
                    app:cardCornerRadius="@dimen/radius_dash"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_avg_screen_time"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="@color/skor_text_dim"
                            android:textAllCaps="true"
                            android:letterSpacing="0.1" />

                        <TextView
                            android:id="@+id/tv_period_total_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceDisplaySmall"
                            android:textStyle="bold"
                            android:textColor="@color/skor_text" />

                        <TextView
                            android:id="@+id/tv_period_total_sum"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/skor_text_dim" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="@dimen/spacing_xs">

                            <TextView
                                android:id="@+id/tv_period_unlocks"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="@color/skor_text_dim" />

                            <TextView
                                android:id="@+id/tv_trend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_glass"
                                android:paddingHorizontal="@dimen/spacing_sm"
                                android:paddingVertical="4dp"
                                android:textAppearance="?attr/textAppearanceLabelMedium"
                                android:textStyle="bold"
                                android:textColor="@color/skor_text"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Per-day activity line chart -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    app:cardBackgroundColor="@color/skor_card"
                    app:cardCornerRadius="@dimen/radius_dash"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="@dimen/spacing_sm">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/stats_activity"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:textStyle="bold"
                                android:textColor="@color/skor_text_dim" />

                            <TextView
                                android:id="@+id/tv_period_pill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_glass"
                                android:paddingHorizontal="@dimen/spacing_sm"
                                android:paddingVertical="4dp"
                                android:textAppearance="?attr/textAppearanceLabelMedium"
                                android:textStyle="bold"
                                android:textColor="@color/skor_warn" />
                        </LinearLayout>

                        <com.example.stayfree.ui.common.UsageLineChartView
                            android:id="@+id/chart_period"
                            android:layout_width="match_parent"
                            android:layout_height="170dp"
                            app:lineColor="@color/skor_focus"
                            app:gridColor="@color/skor_line"
                            app:axisTextColor="@color/skor_text_dim"
                            app:tooltipValueColor="@color/skor_text"
                            app:markerSolidColor="@android:color/white"
                            app:markPeak="true"
                            app:markersAllPoints="true" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_most_used_apps"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textStyle="bold"
                    android:textColor="@color/skor_text"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_period_apps"
                    android:layoutAnimation="@anim/layout_animation_slide_up"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
