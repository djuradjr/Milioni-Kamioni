<?xml version="1.0" encoding="utf-8"?>
<!-- Darkens the photo where the copy sits (middle) and lets it breathe at the
     edges, so white text stays legible on any of the block backgrounds. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerY="0.45"
        android:startColor="#59080F18"
        android:centerColor="#AD0F1926"
        android:endColor="#33080F18" />
</shape>
