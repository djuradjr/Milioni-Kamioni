    <!-- ===================== SKOR design system (light) =====================
         The dark values in values-night/ are the designed original; these are a
         translation, not an inversion: teal, amber and orange are all darkened
         because the dark-mode hues fall under 4.5:1 on a white ground.
         Rule: orange means distraction/blocking ONLY — never brand chrome.
         Accent colors on light surfaces are text-safe; *_soft are chip fills. -->
    <color name="skor_ground">#EFF2F6</color>
    <color name="skor_card">#FFFFFF</color>
    <color name="skor_card_raised">#E4EAF2</color>
    <color name="skor_line">#DCE3EC</color>
    <color name="skor_nav">#FFFFFF</color>
    <color name="skor_track">#E2E8F0</color>

    <color name="skor_text">#111C2B</color>
